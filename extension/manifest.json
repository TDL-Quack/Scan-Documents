{
  "manifest_version": 3,
  "name": "Scanner de documents pour Gmail",
  "short_name": "Scanner docs",
  "version": "1.0.0",
  "description": "Transforme les photos de documents reçues dans Gmail en documents « scannés » (recadrés, redressés, fond blanc), prêts à imprimer. Tout est traité localement.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Ouvrir le scanner de documents",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "contextMenus"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://*.googleusercontent.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "minimum_chrome_version": "116",
  "homepage_url": "https://github.com/TDL-Quack/Scan-Documents"
}
